# Copy to .env and fill in values
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=0

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=mnea_auth

# Bcrypt cost factor (12 recommended)
BCRYPT_LOG_ROUNDS=12

# Session / security
PERMANENT_SESSION_LIFETIME_MINUTES=30

# Mail (forgot password) — Gmail example uses App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_DEFAULT_SENDER=no-reply@mnea.edu.mm
MAIL_PASSWORD=

# Public URL prefix for password reset links (no trailing slash)
# e.g. http://localhost:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Rate limits (optional tuning)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_MAX_PER_HOUR=3
