# Copy to .env next to app.py — required for app.py (load_dotenv)
FLASK_SECRET_KEY=replace-with-long-random-string

# MySQL — required (main app + auth module use the same database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=mnea_academy

# Public URL for password-reset emails (Flask-Mail also required)
PUBLIC_BASE_URL=http://127.0.0.1:5001

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@localhost

BCRYPT_LOG_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PERMANENT_SESSION_LIFETIME_MINUTES=30
